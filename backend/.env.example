PORT=5000
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/discord/callback
SESSION_SECRET=change_this_random_value
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Railway volume mount path; set this to /app/data on Railway.
# DATA_DIR=/app/data
# Shared secret used by the Roblox server script when posting spawns.
# ROBLOX_API_KEY=generate_a_long_random_value
